# Activar motor de reescritura
RewriteEngine On

##########################################
# 🔹 1. Redirección limpia para /tyc
##########################################

# Si el usuario escribe /tyc/indexTC.html → redirigir a /tyc
RewriteCond %{THE_REQUEST} /tyc/indexTC\.html [NC]
RewriteRule ^tyc/indexTC\.html$ /tyc [R=301,L]

# Definir archivo por defecto dentro de /tyc
DirectoryIndex indexTC.html index.html index.php


##########################################
# 🔒 Opciones generales
##########################################

# Evitar listado de archivos
Options -Indexes

# Forzar codificación UTF-8
AddDefaultCharset UTF-8

# Control básico de caché del navegador (7 días)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 7 days"
  ExpiresByType image/jpeg "access plus 7 days"
  ExpiresByType image/png "access plus 7 days"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
</IfModule>

##########################################
# 🌐 (Opcional) Forzar HTTPS y sin www
##########################################
# Descomentar las siguientes líneas si querés redirigir todo a https://sunsetdrive.com.ar
#RewriteCond %{HTTPS} !=on [OR]
#RewriteCond %{HTTP_HOST} ^www\. [NC]
#RewriteRule ^(.*)$ https://sunsetdrive.com.ar/$1 [R=301,L]